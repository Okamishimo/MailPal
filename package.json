{
  "name": "mailpal",
  "version": "0.0.1",
  "private": true,
  "license": "GPL-3.0-only",
  "author": "Maximilian Schiller <github@mxis.ch>",
  "description": "A privacy-focused email forwarding service built on Cloudflare Workers",
  "repository": {
    "type": "git",
    "url": "https://github.com/betahuhn/mailpal.git"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:worker": "npm --prefix email-worker run check",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "npm --prefix email-worker test",
    "test:worker": "npm --prefix email-worker test",
    "verify": "npm run check:worker && npm run test && npm run check && npm run build",
    "prepare": "git config core.hooksPath .githooks || true",
    "deploy:frontend": "npm run build && wrangler pages deploy",
    "deploy:worker": "wrangler deploy --config email-worker/wrangler.toml",
    "deploy:worker:dry-run": "wrangler deploy --dry-run --config email-worker/wrangler.toml",
    "deploy": "npm run deploy:frontend && npm run deploy:worker"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "@internationalized/date": "^3.12.0",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "wrangler": "^4.76.0"
  },
  "dependencies": {
    "bits-ui": "^2.16.3",
    "iron-session": "^8.0.4"
  },
  "type": "module"
}
